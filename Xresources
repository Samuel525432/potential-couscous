! --------------------------------------------------------------------
! NeXTSTEP 3.0 Minimalist Xterm Configuration Theme
! --------------------------------------------------------------------

! Core Frame and Contrast Backgrounds
XTerm*background:       black
XTerm*foreground:       white
XTerm*cursorColor:      white

! Internal Mechanics & Padding
XTerm*scrollBar:        false
XTerm*saveLines:        4096

! Fonts (Replicates the un-smoothed Nimbus/Helvetica style on your T490)
XTerm*faceName:         Nimbus Sans:style=Bold
XTerm*faceSize:         13
XTerm*renderFont:       true

! Classic Right-Click / Ctrl-Click Xterm Popup Menus
XTerm*mainMenu*Background:  #C0C0C0
XTerm*mainMenu*Foreground:  black
XTerm*vtMenu*Background:    #C0C0C0
XTerm*vtMenu*Foreground:    black
XTerm*fontMenu*Background:  #C0C0C0
XTerm*fontMenu*Foreground:  black
