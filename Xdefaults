! ==============================================================================
! XLockMore Configuration for WindowMaker / WDM
! Mode: qix (Classic Retro Line-Vector Animation)
! ==============================================================================

! Authentic NeXTSTEP 3.0 Styled XLock Configurations
XLock.mode:             qix
XLock.qix.count:        4
XLock.qix.cycles:       64

! Colors matching the NeXTSTEP workspace
XLock.background:       #333366
XLock.foreground:       #D8D8D8
XLock.textcolor:        #A0A0A0

! --- THE FONT & PADDING FIXES ---
! Use clean, crisp fixed-width standard fonts to force consistent spacing
XLock.font:             9x15
XLock.planfont:         6x10

! Short prompts with trailing spaces to push the text boxes away from labels
XLock.username:         User:  
XLock.password:         Pass:  
XLock.validate:         Checking...
